# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# --- Optional: Custom LLM / External Upstream LLM ---
# When using Agora's integrated ready-to-use models (default OpenAI gpt-4o-mini),
# NO external keys or URLs are needed. Only the Agora credentials above are required.
# If routing through a custom LLM endpoint, set the following:

# Agora → EchoSphere custom LLM (public HTTPS URL that Agora cloud can call)
# Example: https://<public-host>/api/chat/completions
# Do not use http://localhost — Agora cannot reach it.
ECHOSPHERE_LLM_URL=

# Secret Agora sends as Authorization: Bearer when calling EchoSphere.
# Server-side only. Never expose this to the browser.
ECHOSPHERE_LLM_API_KEY=

# EchoSphere → upstream LLM provider (OpenAI-compatible Chat Completions URL)
# Example: https://api.openai.com/v1/chat/completions
UPSTREAM_LLM_URL=

# Upstream provider API key. Server-side only. Never expose this to the browser.
UPSTREAM_LLM_API_KEY=
